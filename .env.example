# AutoPilot PMO AI - copy to .env and adjust. Never commit .env.
# Demo Mode works with these defaults and no external credentials.

# ---- Mode ---------------------------------------------------------------
# demo      = deterministic simulated agent + local demo enterprise app (no credentials, no paid services)
# connected = Claude agent (needs ANTHROPIC_API_KEY) and/or Salesforce (needs connected-app credentials)
APP_MODE=demo
# Optional overrides: AGENT_BRAIN=simulated|claude   ENTERPRISE_TARGET=demo|salesforce
# e.g. Claude agent against the local demo app:  APP_MODE=connected AGENT_BRAIN=claude ENTERPRISE_TARGET=demo
AGENT_BRAIN=
ENTERPRISE_TARGET=

# ---- Local demo credentials (change for anything beyond a local demo) ----
ENTERPRISE_API_TOKEN=demo-service-token-change-me
ENTERPRISE_ADMIN_TOKEN=demo-admin-token-change-me
APPROVER_API_KEY=demo-approver-key-change-me
APPROVAL_TTL_MINUTES=30

# ---- Claude (Connected Mode) ----------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Price per million tokens used for cost ESTIMATES (defaults exist for known models)
MODEL_PRICE_INPUT_PER_MTOK=
MODEL_PRICE_OUTPUT_PER_MTOK=

# ---- Salesforce (Connected Mode, Developer Edition or sandbox only) --------
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# ---- Execution limits / retention ------------------------------------------
MAX_STEPS=40
MAX_TOOL_CALLS=60
MAX_MODEL_CALLS=25
MAX_COST_USD=2.0
RUN_TIMEOUT_SECONDS=900
AUDIT_RETENTION_DAYS=30

# ---- Host ports (bound to 127.0.0.1) ----------------------------------------
BACKEND_PORT=8000
ENTERPRISE_PORT=8100
UI_PORT=8501
